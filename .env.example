# ── LLM API Keys ──────────────────────────────────────────
OPENAI_API_KEY=sk-proj-...
GROQ_API_KEY=gsk_...

# ── GitHub ────────────────────────────────────────────────
GITHUB_TOKEN=ghp_...
# REQUIRED to enable the webhook endpoint. If empty, POST /api/v1/webhook/github
# returns 503 (prevents anonymous, cost-generating triggers).
GITHUB_WEBHOOK_SECRET=

# ── Database (Supabase transaction pooler) ────────────────
DATABASE_URL=postgresql://postgres.YOURPROJECT:YOURPASSWORD@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres

# ── Weaviate ──────────────────────────────────────────────
# Cloud:  https://YOURCLUSTER...weaviate.cloud  + WEAVIATE_API_KEY
# Local (docker-compose): http://localhost:8080 with empty WEAVIATE_API_KEY
WEAVIATE_URL=https://YOURCLUSTER.c0.eu-central-1.aws.weaviate.cloud
WEAVIATE_API_KEY=...

# ── Auth ──────────────────────────────────────────────────
# REQUIRED in production (startup fails on the insecure default).
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-32-byte-hex-secret-here

# ── CORS ──────────────────────────────────────────────────
# Comma-separated allowed origins. The dashboard is served by the app itself
# (same-origin), so only add origins if hosting the frontend elsewhere.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ── App Settings ──────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
# Hard per-task token budget — the agent loop stops when it is exhausted.
MAX_TOKENS_PER_TASK=50000
PRIMARY_LLM=gpt-4o
# Format: <provider>/<model-id>. llama-3.1/3.3-70b-versatile are decommissioned on Groq.
FALLBACK_LLM=groq/openai/gpt-oss-120b
