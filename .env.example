# Nothing here is required to run the tests or `python -m app.cli demo`.

# ── LLM chain: "<provider>/<model-id>", tried in order ─────────────────
# Providers: groq | google | openai. A provider without a key is skipped.
# llama-3.1/3.3-70b-versatile are decommissioned on Groq free tiers.
PRIMARY_LLM=groq/openai/gpt-oss-120b
FALLBACK_LLM=google/gemini-3.6-flash
HYDE_LLM=                       # optional cheaper model for HyDE
GROQ_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=
# Hard per-task token budget — the agent loop stops when it is exhausted.
MAX_TOKENS_PER_TASK=50000
# Free tiers are rate-limited per minute: when every provider returns 429, wait
# as long as the API asks (capped) and retry, up to N times.
LLM_RATE_LIMIT_RETRIES=3
LLM_MAX_WAIT_S=65
# Retrieved-code budget per prompt; ~3500 keeps Groq free-tier requests under 8k tokens.
CONTEXT_TOKENS=6000

# ── GitHub ──────────────────────────────────────────────────────────────
GITHUB_TOKEN=                   # optional for public repos (60 -> 5000 req/h)
# REQUIRED to enable the webhook endpoint; otherwise it returns 503
# (prevents anonymous, cost-generating triggers).
GITHUB_WEBHOOK_SECRET=

# ── Storage: SQLite by default; Postgres/Supabase also works ───────────
DATABASE_URL=sqlite:///./nexus.db
# DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres

# ── Retrieval: local (in-memory BM25 hybrid) | weaviate ────────────────
RETRIEVER=local
# Cloud: https://CLUSTER.weaviate.cloud + WEAVIATE_API_KEY · Local: http://localhost:8080
WEAVIATE_URL=http://localhost:8080
WEAVIATE_API_KEY=

# ── Patch gate ──────────────────────────────────────────────────────────
GATE_TEST_COMMAND=              # e.g. python -m pytest -q -x  (runs on the host: trusted repos only)
REVIEW_PASS_THRESHOLD=0.7
MAX_REFLECTIONS=2

# ── App ─────────────────────────────────────────────────────────────────
# REQUIRED in production (startup fails on the insecure default).
# python -c "import secrets; print(secrets.token_hex(32))"
# SECRET_KEY=<64 hex chars>
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
